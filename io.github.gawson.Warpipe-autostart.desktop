[Desktop Entry]
Type=Application
Name=Warpipe
Name[pl]=Warpipe
Comment=Choose which apps are heard in your Discord Go Live stream
Comment[pl]=Do streamu w Discordzie trafia tylko dźwięk wybranych aplikacji
Exec=warpipe --tray
Icon=io.github.gawson.Warpipe
Terminal=false
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=panel
