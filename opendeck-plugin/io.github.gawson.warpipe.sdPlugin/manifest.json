{
  "Name": "Warpipe",
  "Description": "Keys for your Discord Go Live stream: put a chosen app's audio on stream, or the whole system. Requires the Warpipe program (warpipe).",
  "Author": "warpipe",
  "Version": "1.0.0",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "Icon": "icons/plugin",
  "Category": "Discord",
  "CategoryIcon": "icons/category",
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "bin/warpipe-plugin",
    "aarch64-unknown-linux-gnu": "bin/warpipe-plugin"
  },
  "CodePathLin": "bin/warpipe-plugin",
  "OS": [
    {
      "Platform": "linux"
    }
  ],
  "Actions": [
    {
      "UUID": "io.github.gawson.warpipe.app",
      "Name": "App audio",
      "Icon": "icons/action-app",
      "Tooltip": "Adds or removes the selected app's audio (e.g. a game) to/from your Discord Go Live stream",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/app.html",
      "States": [
        {
          "Image": "icons/key-app"
        }
      ]
    },
    {
      "UUID": "io.github.gawson.warpipe.system",
      "Name": "Whole system",
      "Icon": "icons/action-system",
      "Tooltip": "Your Discord stream gets all system audio (Discord's normal behaviour)",
      "Controllers": ["Keypad"],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "icons/key-system"
        }
      ]
    }
  ]
}
