#!/usr/bin/python3 -I
# Warpipe — OpenDeck / Stream Deck plugin (plugin process).
# -I: no PYTHONPATH, no current or script directory in sys.path (OpenDeck starts
# the plugin in its own directory). Our own modules come only from ../lib.
import os
import sys

sys.dont_write_bytecode = True
_lib = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib")
sys.path.insert(0, _lib)

from warpipe_plugin.main import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
